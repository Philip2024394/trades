# Capability-labs + external-audits runtime output
data/capability-labs/
data/external-audits/

# master-ai journals + rotated archives
data/master-ai/*.jsonl
data/master-ai/*.jsonl.gz
data/master-ai/*.jsonl.gz.purged

# nex-agent error ledger
data/nex-agent-turbopack-errors/ledger.json

# nex-lab process liveness + scraper state + wikidata cache
data/nex-lab/*.heartbeat
data/nex-lab/*.pid
data/nex-lab/hq-*.jsonl
data/nex-lab/*-cursor.json
data/nex-lab/*-health.json
data/nex-lab/wikidata-cache/

# MaxMind GeoLite2 databases · provisioned per machine by ops, never
# committed. Monthly refresh cadence · size ~70MB. See deploy/maxmind/README.md.
deploy/maxmind/*.mmdb

# NEX Canonical · runtime file-backed state for the sealed Directory
# Engine. Pending-review queue, decision log, checkpoint log · all
# append-only JSONL · per-machine state regenerated/extended by each
# ingestion run. Not source of truth.
data/nex-canonical/*.jsonl

