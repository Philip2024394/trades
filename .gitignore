node_modules
.next
.env*
!.env.local.example
!.env.example
*.tsbuildinfo
.DS_Store
.vercel

# Pexels populator cache — regenerated every run, not source of truth
scripts/.pexels-results.json
scripts/.pexels-query-cache.json

.vercel

.env.tools.local

# Runtime log — not source of truth
dev.log

# Local scratch — source images before processing, mockup HTML,
# screenshots. Processed outputs live in /public/ and are tracked.
tmp/

# Brain-authoring staging JSONs — session state for import scripts,
# regenerated on demand, not source of truth.
scripts/.staging-*.json

# Author Studio local drafts folder — filesystem fallback used only
# in dev before the drafts DB migration is applied.
.author-studio-drafts/

# Manifest auto-backups — rotating recovery snapshots written by the
# save endpoint (kept locally, last 50). Adds up to hundreds of MB and
# would bloat the repo. Recovery lives locally on each dev's machine.
data/.manifest-backups/

# Local recovery snapshots — created by hand during incident recovery
# (2026-07-27 manifest corruption). Not shared state.
data/.recovery-*/

# Timestamped .bak files written by knowledge editors — the .json
# source is the truth, the .bak.* copies are local rotation history.
*.bak.*
knowledge/*.bak.*

# NEX Knowledge Inbox runtime store — user-dumped content, per-machine.
# The directory and README are tracked so the path exists; runtime data
# stays local. When this graduates to Supabase/Postgres, this rule
# becomes irrelevant.
data/knowledge-inbox/index.json
data/knowledge-inbox/stats.json
data/knowledge-inbox/content/
data/knowledge-inbox/files/

# NEX Brain runtime store — filesystem backend data. Per-machine.
# Once NEX_BRAIN_BACKEND=supabase is set, this directory stays empty
# and everything lives in the Supabase Postgres instead.
data/nex-brain/*.json

# Temp forensic + scratch audit artifacts — never committed
tmp-forensic/
tmp-imgaudit.json
backups/

# UK Staircase Trade Market · temp HTML dumps from Agent 1 curl fallback
# (Agent 1 lacked permission to delete them from its sandbox; JSON deliverables live alongside)
data/directory-seeds/_staircase_uk_stage2/*.html
