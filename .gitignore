.DS_Store
.vercel

# Pexels populator cache — regenerated every run, not source of truth
scripts/.pexels-results.json
scripts/.pexels-query-cache.json

.vercel

.env.tools.local

# Runtime log — not source of truth
dev.log

# Local scratch — source images before processing, mockup HTML,
# screenshots. Processed outputs live in /public/ and are tracked.
tmp/

# Brain-authoring staging JSONs — session state for import scripts,
# regenerated on demand, not source of truth.
scripts/.staging-*.json

# Author Studio local drafts folder — filesystem fallback used only
# in dev before the drafts DB migration is applied.
.author-studio-drafts/

# Manifest auto-backups — rotating recovery snapshots written by the
# save endpoint (kept locally, last 50). Adds up to hundreds of MB and
# would bloat the repo. Recovery lives locally on each dev's machine.
data/.manifest-backups/

# Local recovery snapshots — created by hand during incident recovery
# (2026-07-27 manifest corruption). Not shared state.
data/.recovery-*/

# Timestamped .bak files written by knowledge editors — the .json
# source is the truth, the .bak.* copies are local rotation history.
*.bak.*
knowledge/*.bak.*

# NEX Knowledge Inbox runtime store — user-dumped content, per-machine.
# The directory and README are tracked so the path exists; runtime data
# stays local. When this graduates to Supabase/Postgres, this rule
# becomes irrelevant.
data/knowledge-inbox/index.json
data/knowledge-inbox/stats.json
data/knowledge-inbox/content/
data/knowledge-inbox/files/

# NEX Brain runtime store — filesystem backend data. Per-machine.
# Once NEX_BRAIN_BACKEND=supabase is set, this directory stays empty
# and everything lives in the Supabase Postgres instead.
data/nex-brain/*.json

# Temp forensic + scratch audit artifacts — never committed
tmp-forensic/
tmp-imgaudit.json
backups/

# UK Staircase Trade Market · temp HTML dumps from Agent 1 curl fallback
# (Agent 1 lacked permission to delete them from its sandbox; JSON deliverables live alongside)
data/directory-seeds/_staircase_uk_stage2/*.html

# 2026-08-23 · Added when pushing catch-up commit.
# Dev server logs (regenerated on every start)
.next-dev.err
.next-dev.log
# Tesseract OCR training data — 5-7 MB binaries · load at runtime, not source
*.traineddata
# Ad-hoc QA screenshots · not source of truth
tmp-nex-qa-screenshots-chat/

# V.5.4.3 L4 bakeoff transcripts · Founder-authorization-scoped · no secrets · never version-controlled
data/l4-bakeoff/transcripts/*/*.json
data/l4-bakeoff/transcripts/*/*.jsonl

# 2026-09-12 · Root pollution cleanup
# AI-generated Master AI Engineer / NEX reports written to repo root during long sessions.
# Kept locally for reference; not source of truth. Move to docs/reports/ if you want them shared.
/_master_ai_*.md
/_nex_*.md
/_apply_*.sql
# One-off model stream logs and post-run test artefacts
/.qwen3-*.jsonl
/.vitest-post.json
# Phase 8 T3 test workspaces — ephemeral attack harness output
.nex/workspaces-*/
# Ad-hoc measurement / scratch scripts left at repo root
/tmp-measure-*.mjs

# 2026-09-12 · Runtime state files — regenerated by workers/schedulers, not source of truth.
# Committing them means every dev pulls stale runtime state on next clone.
data/indonesia/watchdog-incidents.jsonl
data/indonesia/workforce-state.json
data/nex-events/events.jsonl
data/nex-learning-log.jsonl
data/nex-storage/object_manifest.jsonl

# 2026-09-12 · API response caches — regenerated per scrape run.
# Overpass/Google/etc. caches churn every workforce or acquisition run.
scripts/nex-acquisition/.cache/
scripts/*/.cache/

# 2026-09-12 · Large binaries and DB dumps — GitHub blocks files >100 MB
# and warns at >50 MB. These must be fetched by setup scripts or stored
# externally (S3 / GCS), never in git history.
deploy/minio/minio.exe
deploy/minio/minio
deploy/**/*.exe
deploy/**/*.tar.gz
# PostgreSQL / DB dumps — backups belong in object storage, not git
data/nex-backups/*.dump
data/nex-backups/*.sql.gz
*.dump
# Oversized data-load SQL files (622 MB backfill etc.) — split DDL from
# bulk data or store the bulk load separately.
data/migration-*/backfill-*.sql

# 2026-09-12 · NEX agent workspaces are per-Work-Order ephemeral clones
# of the repo. They accumulate .cache/, next-dev.log, mediapipe wasm
# duplicates, and workspace state. Not source of truth.
data/nex-agent-workspaces/

# Development / dev-server / harvest logs written under data/ by workers
# and dev processes. Never source of truth.
data/**/*.log

# Files explicitly marked for deletion (`.todelete` suffix)
**/*.todelete

# 2026-09-12 · NEX agent runtime state — heartbeats, PIDs, event logs,
# command queues, override flags. All actively written by background
# agents (accommodation, business, master_ai, programmer, speaking,
# travel, vision) and cannot be reliably git-staged while agents run.
data/nex-agent-runtime/

# 2026-09-12 · MinIO on-disk storage — the actual bucket data for a
# local MinIO server. Includes .minio.sys internal metadata (xl.meta
# files continuously rewritten while the server runs) and the raw
# object bytes stored in nex-backups, nex-media-videos,
# nex-network-uploads, nex-notebook-receipts, nex-sitebook-cost-docs.
# MinIO storage belongs on the filesystem, not in git.
deploy/minio/data/
# MinIO server-side logs written to the deploy dir root, outside data/
deploy/minio/*.log
deploy/minio/*.log.err

# 2026-09-13 · WO-WORKSTATION-01 durable-store runtime data.
# nex1_workflow_traces / nex1_audit_events / nex1_idempotency_lookup
# are the actual persisted state of workstation projects. They live
# on disk in the jsonl backend; they are NOT source of truth for git.
# On Vercel, the postgres/dual-write backend takes over and these
# files never exist. Locally they accumulate per test/dev run.
data/nex-storage/nex1_workflow_traces.jsonl
data/nex-storage/nex1_audit_events.jsonl
data/nex-storage/nex1_idempotency_lookup.jsonl

# 2026-09-13 · WO-WORKSTATION-02 durable authorization storage.
# nex1_founder_authorizations holds signed Ed25519 envelopes with
# nonce + chain-of-custody. Real persisted state; not source of truth
# for git. Founder key manifest lives separately at a path defined by
# NEX_FOUNDER_KEY_MANIFEST_PATH (never committed regardless).
data/nex-storage/nex1_founder_authorizations.jsonl
# WO-WORKSTATION-08 · Engineering evidence runtime files. Every project's
# reports land here on the jsonl backend; on Vercel the postgres backend
# takes over and these never exist. Not source of truth.
data/nex-storage/nex1_execution_reports.jsonl
data/nex-storage/nex1_build_reports.jsonl
data/nex-storage/nex1_runtime_reports.jsonl
data/nex-storage/nex1_specialist_results.jsonl
# Local founder key manifests -- private material never lands in git,
# and public-key-only manifests should live in secure config, not repo.
.founder-keys.local.json
config/founder-keys.local.json

# 2026-09-12 · Content-addressed Wikidata cache written by the lab
# harvester. Keyed by content hash; regenerates on demand.
data/nex-lab/wikidata-cache/

# 2026-09-12 · Timestamped OSM harvest snapshots — one per run,
# regenerated by the harvest walker; kept locally for inspection.
data/harvest-osm/osm-*T*Z.jsonl

# WO-13 · substrate-attestation private key must NEVER be committed
.nex-secrets/

# 2026-09-19 · IP Protection Gate — additional secret / delegation surfaces.
# nex_founder_delegations.jsonl carries Ed25519 delegation envelopes (signatures + nonces).
# founder-key-tmp-* directories carry temporary private key material used by delegation tests.
# Neither should ever land in git history.
data/nex-storage/nex_founder_delegations.jsonl
data/founder-key-tmp-*/

# 2026-09-19 · IP Protection Gate — NEX cognitive intelligence corpus.
# entries.jsonl (investigation conclusions) contains real Q8 selections + provenance.
# Every jsonl under nex-storage is a durable cognitive/runtime record — never git-tracked.
# Every subtree under data/nex1-*/ carries experiment receipts + learned patterns.
# These files ARE the proprietary NEX experience corpus.
data/nex1-investigation-conclusions/entries.jsonl
data/nex-storage/*.jsonl
data/nex1-*/**/*.jsonl
data/nex1-*/**/*.json
data/nex1-*/**/*.mjs
data/nex1-*/**/*.md
# Historical preservation snapshot receipts (leave already-committed baselines untouched
# for provenance · but new snapshots stay local).
data/nex1-preservation/*.json.new

# 2026-09-15 · Wave P0 · NEX Visual Engine weights storage.
# Model weight files (GB-scale binaries) live here after a bounded engine
# registration wave downloads them. Weights are content-addressed and
# never source of truth for git · they are re-downloadable from first-
# party provenance recorded in data/nex-visual-model-licences.json.
data/nex-visual-engine-weights/

# 2026-09-15 · SDXL smoke-test outputs · regenerated on demand · not source of truth.
data/nex-sdxl-smoke-test/

# 2026-10-02 · Background-process runtime artifacts.
# Continuously written by harvest / scraper / journal workers; never source
# of truth for git. Pre-existing tracked copies are being `git rm --cached`d
# in the same commit so the index agrees with these rules.

# Alert daily journals
data/alerts/*.jsonl

# Harvest + knowledge-acquisition pipeline state
data/harvest-osm/cursor.json
data/indonesia/knowledge-gaps.json
