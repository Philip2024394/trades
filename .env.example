# NEX Headquarters · environment template
#
# Copy this file to `.env.local` and fill in the values that apply to
# your environment. Only Headquarters-critical vars are documented here.
# Full application config lives in the deployment docs.
#
# Values marked REQUIRED-IN-PRODUCTION are enforced by the code: an
# absent value will cause the associated endpoint to fail-closed
# (500 misconfigured) when NODE_ENV=production. This is intentional
# and prevents accidentally deploying an open pipeline endpoint.

# ─────────────────────────────────────────────────────────────────
# CRON authentication (Wave 11 remediation · F14/F15/F30)
# ─────────────────────────────────────────────────────────────────
#
# The NEX brain pipeline is driven by two endpoints:
#   · GET  /api/nex/brain/cron-tick   (Vercel Cron entrypoint)
#   · POST /api/nex/brain/run-once    (manual + external cron)
#
# Both endpoints route through the SHARED auth boundary at
# src/lib/nex/brain/auth/require-cron-token.ts. In production, at
# least ONE of the two tokens below MUST be set OR the endpoint
# refuses to serve.
#
# In local development, both may be unset (dev convenience) — the
# server will log a one-time warning that the endpoints are open.

# CRON_SECRET · Vercel Cron uses this automatically. Set it in the
# Vercel project env when the app is deployed. REQUIRED-IN-PRODUCTION
# unless NEX_BRAIN_CRON_TOKEN is set instead. 32+ hex chars recommended.
CRON_SECRET=

# NEX_BRAIN_CRON_TOKEN · external cron services (cron-job.org,
# GitHub Actions, Supabase pg_cron) pass this as either
# `Authorization: Bearer <token>` or `X-Brain-Cron-Token: <token>`.
# REQUIRED-IN-PRODUCTION unless CRON_SECRET is set instead.
NEX_BRAIN_CRON_TOKEN=

# ─────────────────────────────────────────────────────────────────
# Worker startup gate (Wave 4 · F31)
# ─────────────────────────────────────────────────────────────────
#
# scripts/nex-brain-cloud-worker.ts refuses to start unless this is
# set to exactly "YES". This is the Wave 4 conscious-resume gate —
# it prevents the legacy Fly worker image from accidentally starting
# and reintroducing the split-brain that Wave 1 shut down.
#
# Full context: docs/headquarters-production-readiness/
#                HEADQUARTERS-WORKER-DEPLOYMENT-AUDIT.md section 8.
NEX_WORKER_CONSENT_V2=YES

# ─────────────────────────────────────────────────────────────────
# NEX Postgres (Wave 5/6 · F28)
# ─────────────────────────────────────────────────────────────────
#
# Primary Postgres URL for the nex.* schema. Local dev may leave this
# unset (some subsystems fall back gracefully). In production it MUST
# be set — Wave 11 remediation will fail-closed if unset in prod.
NEX_POSTGRES_URL=

# ─────────────────────────────────────────────────────────────────
# NEX Supabase (transitional · Wave 5 authoritative source)
# ─────────────────────────────────────────────────────────────────
#
# Until Wave 5 backfill completes and NEX_BRAIN_BACKEND flips to
# "postgres", the brain reads/writes still go to Supabase. All three
# aliases below map to the same URL; storage.ts, audit-log.ts, and
# warehouse.ts each accept any of the three (cascade).
NEXT_PUBLIC_NEX_SUPABASE_URL=
NEX_SUPABASE_URL=
NEX_SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────
# Migration feature gates (Wave 6 · F29)
# ─────────────────────────────────────────────────────────────────
#
# Each gate defaults OFF (safe · legacy behaviour). Flip to "postgres"
# / "1" only after the corresponding wave's backfill + rollback
# rehearsal is complete.

# Wave 6a: switch inbox read path to Postgres
NEX_INBOX_READ_BACKEND=

# Wave 6b: shadow-write inbox mutations to Postgres alongside filesystem
NEX_INBOX_SHADOW_POSTGRES=

# Wave 7: reverse-shadow brain writes to Supabase for safe rollback
# (activates only when NEX_BRAIN_BACKEND=postgres AND this = "1")
NEX_BRAIN_SHADOW_SUPABASE=

# Wave 5: primary brain backend selector
# Values: "postgres" | "supabase" | "filesystem" (dev only)
NEX_BRAIN_BACKEND=

# Wave 3: object storage backend selector
# Values: "postgres" | "filesystem"
NEX_OBJECT_BACKEND=

# Wave 3: NEX Storage runtime backend selector
# Values: "jsonl" (default) | "postgres" | "dual-write"
# Note: this is the *NEX Storage* runtime selector · SEPARATE from
# NEX_BRAIN_BACKEND (Brain persistence) and NEX_OBJECT_BACKEND
# (Object Storage). Confusing them is a common source of "why is my
# data going nowhere?" incidents · they must be set independently.
NEX_STORAGE_BACKEND=

# Engineering audit D8 · MUST be unset or "false" in production.
# When true, if every LLM provider fails, a deterministic mock response
# is returned so dev doesn't grind to a halt. In production this hides
# real outages and lets fabricated content flow downstream. Set to
# "false" (or leave unset — code treats unset as false) on Vercel prod.
# Local dev may set to "true" for ergonomics.
LLM_ALLOW_MOCK_FALLBACK=

# D6 · analytics rollup async mode. Set to "1" to defer rollup UPSERTs
# to the background worker (drained on cron-tick). Unset = current sync
# behavior. Recommended for high-throughput ingest; leave off until the
# rollup worker has been proven live in your environment.
NEX_ANALYTICS_ROLLUP_ASYNC=
