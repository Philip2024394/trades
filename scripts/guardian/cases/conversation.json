    "input": { "message": "Halo NEX, apa kabar?", "hasImage": false },
    "expect": { "intent": "conversation", "reasonPattern": "^greeting$" }
  },
  {
    "id": "C-meta",
    "note": "meta-about-NEX → conversation",
