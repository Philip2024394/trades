{
  "_doc": "NEX WORKFORCE JOB REGISTRY · Philip 2026-08-27. Each entry = one permanent category specialist. Adding a job = one entry here · scheduler + rotation + HQ pick it up automatically. Cardinality goal: 10 (Phase 1) → 30 (Phase 2) → 100 (Phase 3).",
  "_doctrine": "Worker identity = category · not city. Geography = Indonesia-wide. Each job continuously sweeps eligible cities via existing Rotation Controller. Surface-level cooldown moves the worker to the next eligible city, NOT globally idle.",
  "_schema": {
    "id": "two-digit string · stable · never renumber",
    "name": "display name shown in HQ",
    "emoji": "1 emoji shown in HQ",
    "category_slug": "canonical lowercase-hyphenated · becomes the `category` column value in nex.discovery_rotation_state AND worker_config token · MUST be unique",
    "target_table": "fully-qualified table where persisted rows land · Phase 1 = existing food/accommodation OR new nex.service_business",
    "strategies": "ordered list · each strategy = one discovery pass · walker cycles through them",
    "geographic_scope": "indonesia-all (Phase 1 default · rotation picks from data/nex-city-catalogue.json) or a named subset (future)"
  },
  "_strategy_schema": {
    "provider": "overpass | nominatim | own-website | wikipedia (Phase 1 uses overpass only · others reserved)",
    "query_kind": "tag (OSM tag pattern) | keyword (Nominatim free-text) | domain (per-website)",
    "params": "provider-specific · Overpass example: { amenity: 'restaurant' } or { shop: 'hairdresser' } or { tag_pairs: [['tourism','hotel']] }"
  },
