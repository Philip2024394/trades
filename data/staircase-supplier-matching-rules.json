  "clarifying_question_rules": {
    "when_ambiguous": [
      { "trigger": "material vs manufacture unclear", "ask": "Are you looking to buy oak boards to make the stair yourself, or looking for a company to make the whole staircase?" },
      { "trigger": "installation vs manufacture unclear", "ask": "Do you have the staircase already and need it fitted, or do you need it made and installed?" },
      { "trigger": "region unspecified", "ask": "Where are you based? A postcode helps me find nearby suppliers." },
      { "trigger": "material unspecified", "ask": "What material are you working in - oak, walnut, painted, glass?" }
    ]
