  "presentation_rules": [
    "Return top 5 matches unless user requests more (max 15)",
    "Show verification level badge (Partner / Verified / Claimed / Listed) per Business Trust doc",
    "Show one-line reason for the match (e.g. 'Hardwood specialist in your region, 5-star staircase relevance')",
    "Show services (delivery / trade account / cutting service) if relevant to the query",
    "If no verified matches, show listed matches WITH the standard unverified-caveat wording",
    "Always offer 'broaden search' if fewer than 3 matches",
    "Never rank paid tier higher than verification level - trust always wins over commercial placement"
  ],

  "engine_workflow": [
    "1. Parse customer natural-language input via requirement_translation_rules -> structured requirement",
    "2. If requirement is ambiguous (e.g. 'I need oak stair stuff'), ask clarifying question before matching",
    "3. Filter merchant directory by supplier_type_routing[route_key].primary and .secondary categories",
    "4. Apply min_staircase_relevance threshold",
    "5. If material_tags_required is set, filter to merchants with those tags",
    "6. Resolve user region via regional_coverage_map, filter merchants with matching coverage",
    "7. Apply verification_preference filter (verified_only / verified_first / any)",
    "8. Score each remaining merchant using scoring_weights sum",
    "9. Sort descending by score",
    "10. Present top 5 with reasoning per match, applying presentation_rules"
  ],

