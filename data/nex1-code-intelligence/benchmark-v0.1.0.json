{
  "version": "v0.1.0",
  "notes": "NEX1 Code Intelligence benchmark · founder-authorised 2026-09-12. SEPARATE evidence track from the Engineering Brain novel-challenge ladder (CI-1). Cases carry: path · content snippet · expected language · expected confidence band · notes. Adversarial cases test refusal + AMBIGUOUS/UNRESOLVED discipline.",
  "cases": [
    { "id": "ci.det.ts.tsconfig",     "path": "src/App.tsx",           "content": "import React from 'react';\nexport const App: React.FC = () => <div />;\n", "expected_language": "tsx",         "expected_confidence": "medium_or_high", "notes": "extension + content signal" },
    { "id": "ci.det.ts.strict",       "path": "src/hello.ts",           "content": "import type { X } from './x';\nexport const y: string = 'z';\n",             "expected_language": "typescript",  "expected_confidence": "medium_or_high", "notes": "extension + import type" },
    { "id": "ci.det.js.mjs",          "path": "scripts/run.mjs",        "content": "import fs from 'node:fs';\nfs.writeFileSync('x','y');\n",                    "expected_language": "javascript",  "expected_confidence": "medium_or_high", "notes": "extension .mjs" },
    { "id": "ci.det.python.shebang",  "path": "tools/deploy",           "content": "#!/usr/bin/env python3\nimport os\nprint(os.getcwd())\n",                     "expected_language": "python",      "expected_confidence": "medium_or_high", "notes": "no extension · shebang + content" },
    { "id": "ci.det.rust",            "path": "src/main.rs",            "content": "use std::io;\nfn main() { println!(\"hi\"); }\n",                             "expected_language": "rust",         "expected_confidence": "medium_or_high", "notes": "extension + fn + use" },
    { "id": "ci.det.go",              "path": "cmd/main.go",            "content": "package main\nimport \"fmt\"\nfunc main() { fmt.Println(\"hi\") }\n",         "expected_language": "go",           "expected_confidence": "medium_or_high", "notes": "extension + package declaration" },
    { "id": "ci.det.java",            "path": "src/Main.java",          "content": "package a.b;\nimport java.util.*;\npublic class Main {}\n",                  "expected_language": "java",         "expected_confidence": "medium_or_high", "notes": "extension + class + import" },
    { "id": "ci.det.bash.shebang",    "path": "scripts/deploy",         "content": "#!/bin/bash\nset -euo pipefail\necho hi\n",                                   "expected_language": "bash",         "expected_confidence": "medium_or_high", "notes": "shebang → bash" },
    { "id": "ci.det.shell.shebang",   "path": "scripts/probe.sh",        "content": "#!/bin/sh\nset -eu\necho hi\n",                                                "expected_language": "shell",        "expected_confidence": "medium_or_high", "notes": "shebang → sh" },
    { "id": "ci.det.json",            "path": "config.json",             "content": "{\"a\":1,\"b\":[2,3]}\n",                                                        "expected_language": "json",         "expected_confidence": "medium_or_high", "notes": "extension + parses" },
    { "id": "ci.det.yaml",            "path": "config.yaml",             "content": "name: x\nversion: 1\n",                                                          "expected_language": "yaml",         "expected_confidence": "medium_or_high", "notes": "extension + yaml prefix" },
    { "id": "ci.det.toml",            "path": "pyproject.toml",           "content": "[project]\nname = 'x'\n",                                                        "expected_language": "toml",         "expected_confidence": "medium_or_high", "notes": "special_basename or extension" },
    { "id": "ci.det.md",              "path": "docs/README.md",           "content": "# Title\n\n* one\n* two\n",                                                      "expected_language": "markdown",      "expected_confidence": "medium_or_high", "notes": "extension + heading" },
    { "id": "ci.det.dockerfile",      "path": "Dockerfile",               "content": "FROM node:20\nWORKDIR /app\nCOPY . .\nRUN npm ci\n",                             "expected_language": "dockerfile",    "expected_confidence": "medium_or_high", "notes": "special_basename" },
    { "id": "ci.det.makefile",        "path": "Makefile",                 "content": "all:\n\techo hi\n",                                                                "expected_language": "makefile",      "expected_confidence": "medium_or_high", "notes": "special_basename" },
    { "id": "ci.det.package_json",    "path": "package.json",             "content": "{\"name\":\"x\",\"version\":\"1.0.0\"}\n",                                       "expected_language": "json",          "expected_confidence": "medium_or_high", "notes": "special_basename + parses" }
  ],
  "adversarial_cases": [
    { "id": "ci.adv.rename_js_to_ts",    "path": "app.ts",       "content": "// plain JS · no types\nfunction add(a, b) { return a + b; }\n",             "expected_language": "typescript_or_ambiguous", "note": "extension says .ts but content is plain JS · CI-3 expects AMBIGUOUS surface with candidates" },
    { "id": "ci.adv.no_extension_ambiguous", "path": "tools/probe", "content": "echo hi\n",                                                                    "expected_language": "unresolved_or_ambiguous",  "note": "no shebang · no extension · content 'echo' fits many shells · UNRESOLVED expected" },
    { "id": "ci.adv.misleading_ext",     "path": "notes.py",       "content": "This is prose in a Python-extension file.\n",                                    "expected_language": "python_or_ambiguous",       "note": "extension says python but content has no python markers · candidate ordering matters" },
    { "id": "ci.adv.mixed_lang",         "path": "template.html",  "content": "<html><script>const x = 1;</script></html>\n",                                    "expected_language": "html",                       "note": "HTML with embedded JS · v0 detects host language (HTML)" },
    { "id": "ci.adv.corrupted",          "path": "broken.py",       "content": "def foo(:::\n    return\n",                                                     "expected_language": "python",                     "note": "syntactically broken · language detection still works · parsing would fail (v0 doesn't parse)" },
    { "id": "ci.adv.executable_content", "path": "danger.sh",       "content": "#!/bin/bash\nrm -rf /\n",                                                       "expected_language": "bash",                       "note": "CI-10 · classification uses static evidence · never executes uploaded code" }
  ]
}
